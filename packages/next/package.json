{
  "name": "@d3set/next",
  "version": "0.1.0",
  "description": "d3set for Next.js (App Router): client and server components, an SSE route helper, and the next.config setup.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
