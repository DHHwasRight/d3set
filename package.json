{
  "name": "d3set",
  "version": "0.1.0",
  "description": "Embeddable d3 chart presentation library: design tokens, live server-sent data, declarative filters.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/d3set.js",
  "module": "./dist/d3set.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/d3set.js"
    },
    "./style.css": "./dist/d3set.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite examples",
    "serve:sse": "node examples/sse-server.mjs",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
